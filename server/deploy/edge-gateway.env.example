EDGE_ADDR=":8443"
EDGE_ALLOW_INSECURE_DECOY="false"
EDGE_CERT_FILE="/etc/edge-gateway/certs/tls.crt"
EDGE_DECOY_ORIGIN="https://example.com"
EDGE_EXPECT_CONTINUE_TIMEOUT="1s"
EDGE_HMAC_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES"
EDGE_INTERNAL_BACKENDS="http://127.0.0.1:8081,http://127.0.0.1:8082"
EDGE_KEY_FILE="/etc/edge-gateway/certs/tls.key"
EDGE_MAX_HEADER_BYTES="65536"
EDGE_MAX_IDLE_CONNS="256"
EDGE_MAX_IDLE_CONNS_PER_HOST="64"
EDGE_READ_HEADER_TIMEOUT="10s"
EDGE_SERVER_IDLE_TIMEOUT="120s"
EDGE_SHUTDOWN_TIMEOUT="30s"
EDGE_SIGNATURE_MAX_SKEW="5m"
EDGE_TLS_HANDSHAKE_TIMEOUT="10s"
EDGE_TLS_MIN_VERSION="1.2"
EDGE_UPSTREAM_IDLE_TIMEOUT="90s"
